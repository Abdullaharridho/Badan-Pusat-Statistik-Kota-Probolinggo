<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F2EE">

    <!-- HEADER -->
    <LinearLayout
        android:id="@+id/ketuaTimHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.cardview.widget.CardView
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="15dp"
            app:cardElevation="3dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="9dp"
                android:src="@drawable/ic_bpslogo"
                android:scaleType="centerInside"
                android:contentDescription="Logo BPS" />

        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BPS Kota Probolinggo"
                android:textColor="#111827"
                android:textSize="17sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Ketua Tim"
                android:textColor="#6B7280"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnKetuaTimMenu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:background="@android:color/transparent"
            android:padding="10dp"
            android:src="@drawable/ic_logout"
            android:scaleType="fitCenter"
            android:contentDescription="Menu akun"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- VIEW PAGER -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/ketuaTimViewPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:overScrollMode="never"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/ketuaTimHeader"
        app:layout_constraintBottom_toTopOf="@id/bottomKetuaTimActivity"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- BOTTOM NAVIGATION -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bottomKetuaTimActivity"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="18dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="28dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false">

            <com.example.bpskota.BottomNavCurveView
                android:layout_width="match_parent"
                android:id="@+id/bottomNavCurveKetuaTim"
                android:layout_height="64dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <!-- SURAT MASUK -->
                <LinearLayout
                    android:id="@+id/navKetuaSurat"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:src="@drawable/ic_mail"
                        app:tint="#9CA3AF"
                        android:contentDescription="Surat Masuk" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Surat"
                        android:textColor="#9CA3AF"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center" />

                </LinearLayout>

                <!-- TIM -->
                <LinearLayout
                    android:id="@+id/navKetuaTim"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:src="@drawable/ic_penduduk"
                        app:tint="#9CA3AF"
                        android:contentDescription="Tim" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Tim"
                        android:textColor="#9CA3AF"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center" />

                </LinearLayout>

                <!-- BERANDA: POSISI TENGAH -->
                <LinearLayout
                    android:id="@+id/navKetuaHome"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/ic_home"
                        app:tint="#F97316"
                        android:contentDescription="Beranda" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Beranda"
                        android:textColor="#F97316"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                </LinearLayout>

                <!-- PETA -->
                <LinearLayout
                    android:id="@+id/navKetuaMaps"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:src="@drawable/ic_master_wilayah"
                        app:tint="#9CA3AF"
                        android:contentDescription="Peta Kode Rumah" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Peta"
                        android:textColor="#9CA3AF"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center" />

                </LinearLayout>

                <!-- PROFIL: POSISI PALING KANAN -->
                <LinearLayout
                    android:id="@+id/navKetuaProfile"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:src="@drawable/ic_account"
                        app:tint="#9CA3AF"
                        android:contentDescription="Profil" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Profil"
                        android:textColor="#9CA3AF"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center" />

                </LinearLayout>

            </LinearLayout>
        </FrameLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
