<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <!-- Konten di dalamnya -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Ikon di tengah atas -->
        <ImageView
            android:id="@+id/ivDialogIcon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="Ikon Internet"
            android:src="@drawable/ic_internet"
            app:tint="#F97316" /> <!-- Hapus app:tint ini jika ikon Anda sudah berwarna -->

        <!-- Judul -->
        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Koneksi Terputus"
            android:textColor="#1F2937"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Deskripsi -->
        <TextView
            android:id="@+id/tvDialogMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Aplikasi memerlukan koneksi internet untuk memuat data terbaru. Periksa jaringan Wi-Fi atau data seluler Anda."
            android:textColor="#4B5563"
            android:textSize="15sp" />

        <!-- Container Tombol -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Tombol Keluar (Outlined) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKeluar"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Keluar"
                android:textAllCaps="false"
                android:textColor="#4B5563"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                app:cornerRadius="12dp"
                app:strokeColor="#D1D5DB" />

            <!-- Tombol Muat Ulang (Solid Warna Aksen BPS) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMuatUlang"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#F97316"
                android:text="Muat Ulang"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                app:cornerRadius="12dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>