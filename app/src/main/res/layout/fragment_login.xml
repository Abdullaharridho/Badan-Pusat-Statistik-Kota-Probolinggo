<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFB"
    android:clipChildren="false">

    <!-- ========================================================= -->
    <!-- BACKGROUND DECORATION                                     -->
    <!-- ========================================================= -->

    <androidx.cardview.widget.CardView
        android:id="@+id/bgAccentTop"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_marginTop="-120dp"
        android:layout_marginEnd="-100dp"
        app:cardBackgroundColor="#18F97316"
        app:cardCornerRadius="130dp"
        app:cardElevation="0dp"
        app:cardMaxElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/bgAccentBottom"
        android:layout_width="210dp"
        android:layout_height="210dp"
        android:layout_marginStart="-100dp"
        android:layout_marginBottom="-100dp"
        app:cardBackgroundColor="#0CF97316"
        app:cardCornerRadius="105dp"
        app:cardElevation="0dp"
        app:cardMaxElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


    <!-- ========================================================= -->
    <!-- MAIN LOGIN CONTAINER                                      -->
    <!-- ========================================================= -->

    <LinearLayout
        android:id="@+id/loginContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="24dp"
        android:paddingEnd="28dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <!-- ===================================================== -->
        <!-- LOGO                                                  -->
        <!-- ===================================================== -->

        <androidx.cardview.widget.CardView
            android:id="@+id/ivLogoContainer"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="38dp"
            app:cardElevation="10dp"
            app:cardMaxElevation="10dp">

            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Logo"
                android:padding="18dp"
                android:src="@drawable/ic_account"
                app:tint="#F97316" />

        </androidx.cardview.widget.CardView>


        <!-- ===================================================== -->
        <!-- TITLE                                                 -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selamat Datang 👋"
            android:textColor="#111827"
            android:textSize="29sp"
            android:textStyle="bold"
            android:fontFamily="sans" />


        <!-- ===================================================== -->
        <!-- SUBTITLE                                              -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="28dp"
            android:lineSpacingExtra="3dp"
            android:text="Masuk untuk mengakses portal data statistik Kota Probolinggo."
            android:textColor="#6B7280"
            android:textSize="14sp" />


        <!-- ===================================================== -->
        <!-- USERNAME                                              -->
        <!-- ===================================================== -->

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEmail"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Username"
            app:boxBackgroundColor="#FFFFFF"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxStrokeColor="#F97316"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:endIconMode="clear_text"
            app:endIconTint="#9CA3AF"
            app:hintTextColor="#F97316"

            app:startIconTint="#9CA3AF">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:gravity="center_vertical"
                android:inputType="text"
                android:paddingStart="4dp"
                android:textColor="#111827"
                android:textColorHint="#9CA3AF"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- ===================================================== -->
        <!-- PASSWORD                                              -->
        <!-- ===================================================== -->

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPassword"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:hint="Password"
            app:boxBackgroundColor="#FFFFFF"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxStrokeColor="#F97316"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:endIconMode="password_toggle"
            app:endIconTint="#9CA3AF"
            app:hintTextColor="#F97316"

            app:startIconTint="#9CA3AF">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:gravity="center_vertical"
                android:inputType="textPassword"
                android:paddingStart="4dp"
                android:textColor="#111827"
                android:textColorHint="#9CA3AF"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- ===================================================== -->
        <!-- FORGOT PASSWORD                                       -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/tvLupaPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="26dp"
            android:clickable="true"
            android:focusable="true"
            android:text="Lupa Password?"
            android:textColor="#F97316"
            android:textSize="14sp"
            android:textStyle="bold" />


        <!-- ===================================================== -->
        <!-- LOGIN BUTTON                                          -->
        <!-- ===================================================== -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginBottom="18dp"
            android:elevation="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Masuk Sekarang"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#F97316"
            app:cornerRadius="14dp"
            app:iconGravity="textEnd"
            app:rippleColor="#33FFFFFF" />


        <!-- ===================================================== -->
        <!-- BRANDING                                               -->
        <!-- ===================================================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Portal Data Statistik"
            android:textColor="#9CA3AF"
            android:textSize="12sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>