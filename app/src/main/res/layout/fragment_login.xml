<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:clipChildren="false">

    <!-- ========================================================= -->
    <!-- AKSEN LATAR BELAKANG ATAS                                 -->
    <!-- ========================================================= -->

    <androidx.cardview.widget.CardView
        android:id="@+id/bgAccentTop"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_marginTop="-100dp"
        android:layout_marginEnd="-120dp"
        app:cardBackgroundColor="#1AF97316"
        app:cardCornerRadius="140dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ========================================================= -->
    <!-- AKSEN LATAR BELAKANG BAWAH                                -->
    <!-- ========================================================= -->

    <androidx.cardview.widget.CardView
        android:id="@+id/bgAccentBottom"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_marginStart="-120dp"
        android:layout_marginBottom="-120dp"
        app:cardBackgroundColor="#0DF97316"
        app:cardCornerRadius="120dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ========================================================= -->
    <!-- MAIN LOGIN CONTAINER                                      -->
    <!-- ========================================================= -->

    <LinearLayout
        android:id="@+id/loginContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="24dp"
        android:paddingEnd="32dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- ===================================================== -->
        <!-- LOGO                                                  -->
        <!-- ===================================================== -->

        <androidx.cardview.widget.CardView
            android:id="@+id/ivLogoContainer"
            android:layout_width="106dp"
            android:layout_height="102dp"
            android:layout_gravity="center"
            android:layout_marginBottom="28dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="40dp"
            app:cardElevation="8dp">

            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Logo"
                android:src="@drawable/ic_bpslogo" />

        </androidx.cardview.widget.CardView>

        <!-- ===================================================== -->
        <!-- USERNAME                                               -->
        <!-- ===================================================== -->

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilUsername"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Username"
            app:boxBackgroundColor="#FFFFFF"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusTopStart="16dp"
            app:boxStrokeColor="#F97316"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:endIconMode="clear_text"
            app:endIconTint="#9CA3AF"
            app:hintTextColor="#F97316"
            app:startIconDrawable="@drawable/ic_user"
            app:startIconTint="#9CA3AF">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:gravity="center_vertical"
                android:inputType="text"
                android:paddingStart="12dp"
                android:textColor="#111827"
                android:textColorHint="#9CA3AF"
                android:textSize="16sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ===================================================== -->
        <!-- PASSWORD                                               -->
        <!-- ===================================================== -->

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPassword"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Password"
            app:boxBackgroundColor="#FFFFFF"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusTopStart="16dp"
            app:boxStrokeColor="#F97316"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:endIconMode="password_toggle"
            app:endIconTint="#9CA3AF"
            app:hintTextColor="#F97316"
            app:startIconDrawable="@drawable/ic_lock"
            app:startIconTint="#9CA3AF">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:gravity="center_vertical"
                android:inputType="textPassword"
                android:paddingStart="12dp"
                android:textColor="#111827"
                android:textColorHint="#9CA3AF"
                android:textSize="16sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ===================================================== -->
        <!-- LOGIN BUTTON                                           -->
        <!-- ===================================================== -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="24dp"
            android:elevation="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Masuk Sekarang"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#F97316"
            app:cornerRadius="16dp"
            app:rippleColor="#33FFFFFF" />

        <!-- ===================================================== -->
        <!-- BRANDING                                               -->
        <!-- ===================================================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Khusus Pegawai BPS Kota Probolinggo "
            android:textColor="#9CA3AF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>