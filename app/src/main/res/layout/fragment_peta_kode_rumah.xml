<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F2EE">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/headerPetaKodeRumah"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Peta Kode Rumah"
            android:textColor="#292524"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Cari lokasi rumah berdasarkan kode wilayah"
            android:textColor="#78716C"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Pencarian kode rumah -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPencarianKodeRumah"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeColor="#E7E5E4"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/headerPetaKodeRumah"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="6dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Ikon pencarian"
                android:src="@android:drawable/ic_menu_search"
                app:tint="#78716C" />

            <EditText
                android:id="@+id/etCariKodeRumah"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Masukkan kode rumah atau ID SubSLS"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textColor="#292524"
                android:textColorHint="#A8A29E"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btnCariKodeRumah"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:backgroundTint="#FFFFFF"
                app:cornerRadius="12dp"
                android:contentDescription="Cari kode rumah"
                android:padding="11dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="#090909" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Filter wilayah -->
    <HorizontalScrollView
        android:id="@+id/scrollFilterWilayah"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:fillViewport="false"
       android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/cardPencarianKodeRumah"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">



            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterKecamatan"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:text="Kecamatan"
                android:textAllCaps="false"
                android:textColor="#57534E"
                android:textSize="12sp"
                app:cornerRadius="12dp"
                app:strokeColor="#D6D3D1"
                app:strokeWidth="1dp"
                app:icon="@android:drawable/arrow_down_float"
                app:iconGravity="end"
                app:iconPadding="6dp"
                app:iconTint="#78716C" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterDesa"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:text="Desa/Kelurahan"
                android:textAllCaps="false"
                android:textColor="#57534E"
                android:textSize="12sp"
                app:cornerRadius="12dp"
                app:strokeColor="#D6D3D1"
                app:strokeWidth="1dp"
                app:icon="@android:drawable/arrow_down_float"
                app:iconGravity="end"
                app:iconPadding="6dp"
                app:iconTint="#78716C" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterSls"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="RT/RW/SLS"
                android:textAllCaps="false"
                android:textColor="#57534E"
                android:textSize="12sp"
                app:cornerRadius="12dp"
                app:strokeColor="#D6D3D1"
                app:strokeWidth="1dp"
                app:icon="@android:drawable/arrow_down_float"
                app:iconGravity="end"
                app:iconPadding="6dp"
                app:iconTint="#78716C" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Area peta OpenStreetMap / MapLibre -->
    <FrameLayout
        android:id="@+id/containerPetaKodeRumah"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:background="#E7E5E4"
        android:clipToOutline="true"
        app:layout_constraintTop_toBottomOf="@id/scrollFilterWilayah"
        app:layout_constraintBottom_toTopOf="@id/containerAksiPeta"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- MapLibre akan dipasang dari Kotlin -->
        <FrameLayout
            android:id="@+id/mapViewContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Petunjuk saat peta pertama kali dibuka -->
        <LinearLayout
            android:id="@+id/layoutPetunjukPeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="Ikon peta"
                android:src="@android:drawable/ic_dialog_map"
                app:tint="#78716C" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Peta Kode Rumah"
                android:textColor="#57534E"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="Cari kode rumah untuk melihat lokasinya"
                android:textColor="#78716C"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Tombol kembali ke posisi GPS -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnLokasiSaya"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:layout_margin="16dp"
            android:contentDescription="Tampilkan lokasi saya"
            android:src="@android:drawable/ic_menu_mylocation"
            app:backgroundTint="#FFFFFF"
            app:elevation="4dp"
            app:fabSize="normal"
            app:tint="#F97316" />

        <!-- Informasi status lokasi -->
        <TextView
            android:id="@+id/tvStatusLokasi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|bottom"
            android:layout_margin="12dp"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:paddingStart="10dp"
            android:paddingTop="7dp"
            android:paddingEnd="10dp"
            android:paddingBottom="7dp"
            android:text="GPS belum diaktifkan"
            android:textColor="#57534E"
            android:textSize="11sp" />

    </FrameLayout>

    <!-- Tombol aksi di bawah peta -->
    <LinearLayout
        android:id="@+id/containerAksiPeta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLihatLog"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="Lihat Log"
            android:textAllCaps="false"
            android:textColor="#57534E"
            android:visibility="gone"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="14dp"
            app:icon="@android:drawable/ic_menu_recent_history"
            app:iconTint="#57534E"
            app:strokeColor="#D6D3D1"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMulaiNavigasi"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:enabled="false"
            android:text="Mulai Navigasi"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            app:backgroundTint="#F97316"
            app:cornerRadius="14dp"
            app:icon="@android:drawable/ic_media_play"
            app:iconTint="#FFFFFF" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
