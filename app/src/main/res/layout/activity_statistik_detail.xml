<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F2EE"

    tools:context=".StatistikDetailActivity">


    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->

    <androidx.cardview.widget.CardView
        android:id="@+id/headerDetail"

        android:layout_width="0dp"
        android:layout_height="78dp"

        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"

        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="20dp"
        app:cardElevation="3dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <!-- BACK -->

            <ImageView
                android:id="@+id/btnBack"

                android:layout_width="44dp"
                android:layout_height="44dp"

                android:layout_marginStart="8dp"

                android:background="?attr/selectableItemBackgroundBorderless"

                android:clickable="true"
                android:focusable="true"

                android:padding="10dp"

                android:src="@drawable/ic_arrow_back"

                android:contentDescription="Kembali"

                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />


            <!-- JUDUL -->

            <TextView
                android:id="@+id/tvDetailJudul"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"

                android:text="Judul Statistik"

                android:textColor="#111827"
                android:textSize="16sp"
                android:textStyle="bold"

                android:maxLines="2"
                android:ellipsize="end"

                app:layout_constraintStart_toEndOf="@id/btnBack"
                app:layout_constraintEnd_toStartOf="@id/btnDownload"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />


            <!-- SPINNER TAHUN
                 Tetap ada ID-nya.
                 Sekarang diletakkan di bawah header,
                 bukan di dalam header.
            -->


            <!-- TAHUN -->

            <TextView
                android:id="@+id/tvDetailTahun"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginEnd="8dp"

                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp"

                android:background="#FFF3E8"

                android:text="2025"

                android:textColor="#F97316"
                android:textSize="13sp"
                android:textStyle="bold"

                android:visibility="gone"

                app:layout_constraintEnd_toStartOf="@id/btnDownload"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />


            <!-- DOWNLOAD -->

            <ImageView
                android:id="@+id/btnDownload"

                android:layout_width="44dp"
                android:layout_height="44dp"

                android:layout_marginEnd="8dp"

                android:background="?attr/selectableItemBackgroundBorderless"

                android:clickable="true"
                android:focusable="true"

                android:padding="10dp"

                android:src="@drawable/ic_download"

                android:contentDescription="Download data"

                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>


    <!-- ========================================================= -->
    <!-- FILTER TAHUN -->
    <!-- ========================================================= -->

    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="58dp"

        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="20dp"

        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"

        app:layout_constraintTop_toBottomOf="@id/headerDetail"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"


            android:paddingStart="16dp"
            android:paddingEnd="8dp">


            <!-- ICON / LABEL -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Tahun Data"

                android:textColor="#6B7280"
                android:textSize="12sp"
                android:textStyle="bold"

                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />


            <!-- SPINNER -->

            <Spinner
                android:id="@+id/spinnerTahun"

                android:layout_width="150dp"
                android:layout_height="44dp"

                android:layout_marginEnd="0dp"

                android:background="#FFFFFF"

                android:paddingStart="12dp"
                android:paddingEnd="12dp"

                android:spinnerMode="dropdown"

                android:dropDownVerticalOffset="6dp"

                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>


    <!-- ========================================================= -->
    <!-- CONTENT -->
    <!-- ========================================================= -->

    <ScrollView
        android:id="@+id/contentScroll"

        android:layout_width="0dp"
        android:layout_height="0dp"

        android:layout_marginTop="14dp"

        android:fillViewport="true"

        android:scrollbars="none"
        android:overScrollMode="never"

        app:layout_constraintTop_toBottomOf="@id/headerDetail"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:paddingStart="20dp"
            android:paddingTop="72dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">


            <!-- ================================================= -->
            <!-- DATA TERSEMBUNYI -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/tvDetailKode"

                android:layout_width="0dp"
                android:layout_height="0dp"

                android:visibility="gone" />


            <TextView
                android:id="@+id/tvDetailBab"

                android:layout_width="0dp"
                android:layout_height="0dp"

                android:visibility="gone" />


            <TextView
                android:id="@+id/tvDetailSubject"

                android:layout_width="0dp"
                android:layout_height="0dp"

                android:visibility="gone" />


            <TextView
                android:id="@+id/tvDetailWilayah"

                android:layout_width="0dp"
                android:layout_height="0dp"

                android:visibility="gone" />


            <TextView
                android:id="@+id/tvDetailSumber"

                android:layout_width="0dp"
                android:layout_height="0dp"

                android:visibility="gone" />


            <!-- ================================================= -->
            <!-- CONTAINER CARD STATISTIK -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/tvDetailData"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical" />

        </LinearLayout>

    </ScrollView>


    <!-- ========================================================= -->
    <!-- LOADING -->
    <!-- ========================================================= -->

    <ProgressBar
        android:id="@+id/progressLoading"

        android:layout_width="48dp"
        android:layout_height="48dp"

        android:visibility="gone"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>