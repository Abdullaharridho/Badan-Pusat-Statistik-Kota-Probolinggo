<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F2EE"
    tools:context=".uisuperadmin.SuperAdminActivity">

    <!-- ========================================================= -->
    <!-- HEADER SUPER ADMIN                                        -->
    <!-- ========================================================= -->

    <LinearLayout
        android:id="@+id/superAdminHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingTop="10dp"
        android:paddingEnd="24dp"
        android:paddingBottom="10dp"
        android:background="#F6F2EE"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ===================================================== -->
        <!-- LOGO BPS                                              -->
        <!-- ===================================================== -->

        <androidx.cardview.widget.CardView
            android:layout_width="52dp"
            android:layout_height="52dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp"
                android:src="@drawable/ic_bpslogo"
                android:scaleType="centerInside"
                android:contentDescription="Logo BPS" />

        </androidx.cardview.widget.CardView>


        <!-- ===================================================== -->
        <!-- JUDUL HEADER                                          -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BPS Kota Probolinggo"
                android:textColor="#111827"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Super Admin"
                android:textColor="#6B7280"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- MENU AKUN / TITIK TIGA                                -->
        <!-- ===================================================== -->

        <ImageButton
            android:id="@+id/btnSuperAdminMenu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@android:color/transparent"
            android:padding="10dp"
            android:src="@drawable/ic_menu1"
            android:scaleType="fitCenter"
            android:contentDescription="Menu akun" />

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- VIEW PAGER                                                -->
    <!-- ========================================================= -->

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/superAdminViewPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:overScrollMode="never"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/superAdminHeader"
        app:layout_constraintBottom_toTopOf="@id/bottomSuperAdminActivity"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ========================================================= -->
    <!-- BOTTOM BAR                                                -->
    <!-- ========================================================= -->

    <androidx.cardview.widget.CardView
        android:id="@+id/bottomSuperAdminActivity"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="36dp"
        app:cardElevation="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- ================================================= -->
            <!-- CURVE BACKGROUND                                    -->
            <!-- ================================================= -->

            <com.example.bpskota.BottomNavCurveView
                android:layout_width="match_parent"
                android:layout_height="64dp" />


            <!-- ================================================= -->
            <!-- NAVIGATION                                         -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <!-- ============================================= -->
                <!-- AKUN                                             -->
                <!-- ============================================= -->

                <LinearLayout
                    android:id="@+id/navSuperUsers"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_account"
                        app:tint="#9CA3AF"
                        android:contentDescription="Akun" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Akun"
                        android:textColor="#9CA3AF"
                        android:textSize="10sp" />

                </LinearLayout>


                <!-- ============================================= -->
                <!-- BERANDA                                         -->
                <!-- ============================================= -->

                <LinearLayout
                    android:id="@+id/navSuperHome"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_home"
                        app:tint="#F97316"
                        android:contentDescription="Beranda" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Beranda"
                        android:textColor="#F97316"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </FrameLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>