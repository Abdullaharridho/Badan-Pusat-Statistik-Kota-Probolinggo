<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F6F2EE"
    tools:context=".uipegawai.PegawaiKegiatanFragment">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="24dp"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KEGIATAN SAYA"
            android:textColor="#F97316"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Agenda &amp; Kegiatan"
            android:textColor="#242424"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Pantau jadwal tugas dan lengkapi laporan kegiatanmu."
            android:textColor="#77716B"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp" />

    </LinearLayout>

    <!-- RINGKASAN STATUS -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingStart="22dp"
        android:paddingEnd="22dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- AKAN DATANG -->
            <androidx.cardview.widget.CardView
                android:layout_width="132dp"
                android:layout_height="105dp"
                android:layout_marginEnd="10dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:padding="15dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Akan Datang"
                        android:textColor="#77716B"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvKegiatanAkanDatang"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="02"
                        android:textColor="#F97316"
                        android:textSize="27sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- PERLU LAPORAN -->
            <androidx.cardview.widget.CardView
                android:layout_width="145dp"
                android:layout_height="105dp"
                android:layout_marginEnd="10dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:padding="15dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Perlu Laporan"
                        android:textColor="#77716B"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvKegiatanPerluLaporan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="01"
                        android:textColor="#D97706"
                        android:textSize="27sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- SELESAI -->
            <androidx.cardview.widget.CardView
                android:layout_width="115dp"
                android:layout_height="105dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:padding="15dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selesai"
                        android:textColor="#77716B"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvKegiatanSelesai"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="04"
                        android:textColor="#16A34A"
                        android:textSize="27sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- TOMBOL KELOLA KEGIATAN HARIAN -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardKelolaKegiatanHarian"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#F97316"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="10dp"
                android:src="@drawable/ic_kalender"
                app:tint="#FFFFFF"
                android:contentDescription="Ikon kegiatan harian" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Kelola Kegiatan Harian"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Tambah, edit, dan hapus kegiatanmu"
                    android:textColor="#FFF3E8"
                    android:textSize="11sp" />

            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_kanan"
      app:tint="@color/white"
                android:contentDescription="Buka kegiatan harian" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- JUDUL DAFTAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="24dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Daftar Kegiatan"
            android:textColor="#242424"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvJumlahKegiatan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3 kegiatan"
            android:textColor="#88817A"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- DAFTAR CARD -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPegawaiKegiatan"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="20dp"
        android:overScrollMode="never"
        tools:listitem="@layout/item_user" />

</LinearLayout>