<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F2EE">

    <ScrollView
        android:id="@+id/infografikScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="120dp"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <!-- JUDUL HALAMAN -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Infografis"
                    android:textColor="#111827"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Temukan informasi statistik dalam bentuk visual yang mudah dipahami."
                    android:textColor="#6B7280"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>


            <!-- SEARCH BAR & FILTER -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="26dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_search"
                            app:tint="#9CA3AF" />

                        <EditText
                            android:id="@+id/etSearchInfografis"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:background="@null"
                            android:hint="Cari infografis..."
                            android:textColor="#111827"
                            android:textColorHint="#9CA3AF"
                            android:textSize="14sp"
                            android:inputType="text"
                            android:imeOptions="actionSearch"
                            android:maxLines="1" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>


                <!-- FILTER -->

                <androidx.cardview.widget.CardView
                    android:id="@+id/btnFilter"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="#F97316"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="14dp"
                        android:src="@android:drawable/ic_menu_sort_by_size"
                        android:scaleType="centerInside"
                        app:tint="#FFFFFF" />

                </androidx.cardview.widget.CardView>

            </LinearLayout>


            <!-- LABEL -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Infografis Terbaru"
                    android:textColor="#111827"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvJumlahInfografis"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 infografis"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp" />

            </LinearLayout>


            <!--
                CONTAINER CARD

                Card dari API akan dimasukkan
                secara dinamis oleh InfografikFragment.

                Layout:
                [ CARD ][ CARD ]
                [ CARD ][ CARD ]
                [ CARD ][ CARD ]
            -->

            <LinearLayout
                android:id="@+id/infografikContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>